@model List<ASPDOTNET_MVC_CRUD.Models.Domain.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Employees</h1>
        <p class="page-subtitle">@Model.Count employee@(Model.Count == 1 ? "" : "s")</p>
    </div>
    <a class="btn btn-primary" asp-controller="Employees" asp-action="Add">Add employee</a>
</div>

@if (Model.Count == 0)
{
    <div class="card-surface empty-state">
        <h2 class="empty-title">No employees yet</h2>
        <p class="empty-text">Add an employee to get started.</p>
        <a class="btn btn-primary" asp-controller="Employees" asp-action="Add">Add employee</a>
    </div>
}
else
{
    <div class="card-surface table-responsive" role="region" aria-label="Employee records" tabindex="0">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Department</th>
                    <th scope="col" class="text-end">Salary</th>
                    <th scope="col">Date of birth</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td>@employee.Name</td>
                        <td>@employee.Email</td>
                        <td>@employee.Department</td>
                        <td class="text-end text-nowrap">@employee.Salary.ToString("N0")</td>
                        <td class="text-nowrap">@employee.DateOfBirth.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-controller="Employees" asp-action="Edit" asp-route-id="@employee.Id" aria-label="Edit @employee.Name">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
