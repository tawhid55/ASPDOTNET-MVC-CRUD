@model ASPDOTNET_MVC_CRUD.Models.Domain.Employee
@{ ViewData["Title"] = "Employee details"; }
<a class="back-link" asp-action="Index">Back to employees</a>
<h1 class="page-title">Employee details</h1>
<div class="card-surface form-card mt-3">
    <dl class="row mb-0">
        <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.Name</dd>
        <dt class="col-sm-4">Email</dt><dd class="col-sm-8 text-break">@Model.Email</dd>
        <dt class="col-sm-4">Department</dt><dd class="col-sm-8">@Model.Department</dd>
        <dt class="col-sm-4">Salary</dt><dd class="col-sm-8">@Model.Salary.ToString("N0")</dd>
        <dt class="col-sm-4">Date of birth</dt><dd class="col-sm-8">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>
    </dl>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-primary mt-3" asp-action="Edit" asp-route-id="@Model.Id">Edit employee</a>
    }
</div>
