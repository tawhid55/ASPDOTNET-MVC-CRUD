@model EmployeeManagement.Models.UpdateEmployeeViewModel

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="page-head page-head-compact">
    <div>
        <a class="back-link" asp-controller="Employees" asp-action="Index">
            Back to employees
        </a>
        <h1 class="page-title">Edit employee</h1>
        <p class="page-subtitle">Update the details for @Model.Name.</p>
    </div>
</div>

<div class="card-surface form-card">
    <form asp-controller="Employees" asp-action="Edit" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Ayesha Rahman" autocomplete="name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="name@company.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Salary" class="form-label"></label>
                <input asp-for="Salary" class="form-control" min="0" step="1" placeholder="55000" />
                <span asp-validation-for="Salary" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" class="form-control" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Department" class="form-label"></label>
                <input asp-for="Department" class="form-control" placeholder="Engineering" />
                <span asp-validation-for="Department" class="text-danger"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                Save changes
            </button>
            <a class="btn btn-outline-secondary" asp-controller="Employees" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

<div class="card-surface danger-card">
    <div>
        <h2 class="danger-title">Delete this employee</h2>
        <p class="danger-text">Removing this record cannot be undone.</p>
    </div>
    <form asp-controller="Employees" asp-action="Delete" method="post"
          onsubmit="return confirm('Delete this employee? This cannot be undone.');">
        <input type="hidden" name="Id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">
            Delete employee
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
